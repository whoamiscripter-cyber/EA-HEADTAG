            }
        }))
    end)
end

local function OnSubmit()
    local text = TextBox.Text
    if text == "" or #text:gsub("%s+", "") == 0 then return end

    local trimmed = text:match("^%s*(.-)%s*$")
    local lowerText = string.lower(trimmed)

    if lowerText == "/pvt" then
        TextBox.Text = ""
        RefreshUserMenu()
        UserMenu.Visible = not UserMenu.Visible
        return
    end

    if lowerText == "/all" then
        TextBox.Text = ""
        SelectedPrivateUser = nil
        TargetTag.Visible = false
        DisplaySystemMessage("Switched back to Public EA Chat.")
        return
    end

    if lowerText == "/logs" then
        TextBox.Text = ""
        LogsScreenGui.Enabled = not LogsScreenGui.Enabled
        return
    end

    if lowerText == "/clear" or lowerText == "/cls" then
        TextBox.Text = ""
        pcall(function()
            if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
                if channel then
                    for i = 1, 15 do channel:DisplaySystemMessage("") end
                end
            end
        end)
        DisplaySystemMessage("Chat screen cleared.")
        return
    end

    if lowerText == "/help" then
        TextBox.Text = ""
        DisplaySystemMessage("--- EA CHAT COMMANDS ---")
        DisplaySystemMessage("• /pvt - Open Script Users list")
        DisplaySystemMessage("• /all - Switch back to Public Chat")
        DisplaySystemMessage("• /logs - Open Chat Logs UI")
        DisplaySystemMessage("• /clear - Clear chat screen")
        return
    end

    TextBox.Text = ""
    BroadcastMessage(text)
end

