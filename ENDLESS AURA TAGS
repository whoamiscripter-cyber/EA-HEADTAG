local function DisplaySystemMessage(text, soundId)
    local fullFormatted = "<font color='#FF3355'><b>[EA System]:</b> " .. text .. "</font>"
    AddLogEntry("[EA System]: " .. text)
    pcall(function()
        StarterGui:SetCore("ChatMakeSystemMessage", {
            Text = "[EA System]: " .. text,
            Color = Color3.fromRGB(255, 50, 85),
            Font = Enum.Font.SourceSansBold,
            TextSize = 14
        })
    end)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then channel:DisplaySystemMessage(fullFormatted) end
        end
    end)
    if soundId then PlayCustomSoundHelper(soundId, 0.6) end
end

local function DisplayChatMessage(sender, message, isPrivate, targetUser)
    local prefix = ""
    local textFormatted = ""
    local sysColor = Color3.fromRGB(255, 80, 110)

    if isPrivate then
        local targetName = targetUser or SelectedPrivateUser or "You"
        prefix = "[PVT] [" .. sender .. " ➔ " .. targetName .. "]: "
        textFormatted = "<font color='#FF2A55' size='13'><b>" .. message .. "</b></font>"
        sysColor = Color3.fromRGB(255, 40, 80)
    else
        prefix = "[" .. sender .. "]: "
        textFormatted = "<font color='#FF7090' size='13'>" .. message .. "</font>"
    end

    AddLogEntry(prefix .. message)
    local fullFormatted = "<font color='#FFFFFF'>" .. prefix .. "</font>" .. textFormatted

    pcall(function()
        StarterGui:SetCore("ChatMakeSystemMessage", {
            Text = prefix .. message,
            Color = sysColor,
            Font = Enum.Font.SourceSansMedium,
            TextSize = 14
        })
    end)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then channel:DisplaySystemMessage(fullFormatted) end
        end
    end)

    local targetPlayer = Players:FindFirstChild(sender)
    if targetPlayer and targetPlayer.Character then
        local head = targetPlayer.Character:FindFirstChild("Head") or targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if head then
            pcall(function()
                local bubbleText = isPrivate and ("[PVT]: " .. message) or message
                ChatService:Chat(head, bubbleText)
            end)
        end
    end

    PlayCustomSoundHelper(MSG_SOUND_ID, 0.4)
end

