local function ConnectWebSocket()
    local success, sock = pcall(function()
        return WebSocket.connect(ENDPOINT)
    end)

    if success and sock then
        Socket = sock

        Socket.OnMessage:Connect(function(RawMessage)
            local Success, Data = pcall(function()
                return HttpService:JSONDecode(tostring(RawMessage))
            end)

            if not Success or type(Data) ~= "table" then return end

            if Data.type == "joined" then
                DisplaySystemMessage("Joined room: " .. tostring(Data.room), JOIN_SOUND_ID)

                ActiveUsersList[Username] = tick()
                if type(Data.history) == "table" then
                    for _, Entry in ipairs(Data.history) do
                        local sender = tostring(Entry.username)
                        if sender and sender ~= "" then
                            ActiveUsersList[sender] = tick()
                        end
                    end
                end
                UpdateAllTagsVisibility()

            elseif Data.type == "say" then
                local sender = tostring(Data.username)
                if sender and sender ~= "" then
                    ActiveUsersList[sender] = tick()
                    UpdateAllTagsVisibility()
                end

                local Payload = Data.payload
                if type(Payload) == "table" and Payload.type == "chat" and type(Payload.text) == "string" then
                    local message = Payload.text
                    local target = Payload.target

                    if sender ~= Username then
                        if target and target ~= "" then
                            if target == Username then
                                DisplayChatMessage(sender, message, true, Username)
                            end
                        else
                            DisplayChatMessage(sender, message, false)
                        end
                    end
                end

            elseif Data.type == "user-joined" then
                if Data.username then
                    local joinedUser = tostring(Data.username)
                    ActiveUsersList[joinedUser] = tick()
                    UpdateAllTagsVisibility()
                    if joinedUser ~= Username then
                        DisplaySystemMessage(joinedUser .. " joined EA-CHAT!", JOIN_SOUND_ID)
                    end
                end

            elseif Data.type == "user-left" then
                if Data.username then
                    local leftUser = tostring(Data.username)
                    ActiveUsersList[leftUser] = nil
                    UpdateAllTagsVisibility()
                    if leftUser ~= Username then
                        DisplaySystemMessage(leftUser .. " left EA-CHAT.")
                    end
                end

            elseif Data.type == "error" then
                DisplaySystemMessage("Error: " .. tostring(Data.code) .. " - " .. tostring(Data.message))
            end
        end)

        Socket.OnClose:Connect(function()
            if isScriptAlive then
                DisplaySystemMessage("Disconnected from OpenFun. Reconnecting...")
                task.wait(3)
                ConnectWebSocket()
            end
        end)

        pcall(function()
            Socket:Send(HttpService:JSONEncode({
                type = "join",
                room = ROOM,
                username = Username,
                password = PASSWORD
            }))
        end)

        task.delay(0.5, function()
            if Socket then
                pcall(function()
                    Socket:Send(HttpService:JSONEncode({
                        type = "say",
                        payload = {
                            type = "sync",
                            text = Username .. " online"
                        }
                    }))
                end)
            end
        end)

        DisplaySystemMessage("Connecting to " .. ROOM .. "...")
    else
        task.wait(3)
        ConnectWebSocket()
    end
end

